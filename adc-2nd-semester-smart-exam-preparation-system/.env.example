# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# AUTH_SECRET: JWT and session secret key for authentication
AUTH_SECRET="your-secure-random-auth-secret-key-adc-2026"

# DATABASE_PATH: Path to SQLite relational database file (or DATABASE_URL for Postgres)
DATABASE_PATH="./data/adc_prep.sqlite"

# ADSENSE_PUBLISHER_ID: Google AdSense publisher ID (e.g., ca-pub-XXXXXXXXXXXXXXXX)
ADSENSE_PUBLISHER_ID="ca-pub-0000000000000000"

